# Copy to .env and fill in values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Storage
CV_BUCKET=cvs
# Worker loop
WORKER_POLL_SECONDS=1
WORKER_ID=worker-1
MAX_ATTEMPTS=3
# Plan 4 requirement extraction is disabled until its worker handler is deployed.
REQUIREMENT_EXTRACTION_ENABLED=false
# AI providers (server-only secrets)
AI_PROVIDER_ORDER=nvidia,ollama,openrouter
AI_TIMEOUT_SECONDS=30
# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Ollama Cloud (no local daemon). OLLAMA_API_KEY and OLLAMA_MODEL are required
# when ollama is listed in AI_PROVIDER_ORDER.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=
# Job discovery connectors
TAVILY_API_KEY=
GREENHOUSE_BOARD_TOKEN=
LEVER_SITE_NAME=
