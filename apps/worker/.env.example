# Copy to .env and fill in values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Storage
CV_BUCKET=cvs
EXPORTS_BUCKET=exports
# Worker loop
WORKER_POLL_SECONDS=1
WORKER_ID=worker-1
MAX_ATTEMPTS=3
# Requirement extraction is enabled by default so new discoveries reach matching.
# Set false only for an intentional discovery-only operation.
REQUIREMENT_EXTRACTION_ENABLED=true
DAILY_DISCOVERY_HOUR_JAKARTA=7
# AI providers (9Router unified gateway)
AI_PROVIDER_ORDER=9router
AI_TIMEOUT_SECONDS=30
# 9Router (OpenAI-compatible AI gateway)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=
# Optional embedding model (if unset, semantic matching falls back to token-set similarity)
NINEROUTER_EMBED_MODEL=
# Job discovery connectors
TAVILY_API_KEY=
GREENHOUSE_BOARD_TOKEN=
LEVER_SITE_NAME=
