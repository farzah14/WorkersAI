# Web / app
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-server-only

# Database / storage
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CV_BUCKET=cvs
EXPORT_BUCKET=exports

# Worker / queue
WORKER_POLL_SECONDS=1
LOG_LEVEL=INFO
DAILY_DISCOVERY_HOUR_ASIA_JAKARTA=7

# AI router
AI_PROVIDER_ORDER=nvidia,openrouter,ollama
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# NVIDIA NIM
NVIDIA_API_KEY=replace-server-only
NVIDIA_BASE_URL=replace-with-openai-compatible-nim-base-url
NVIDIA_MODEL=replace-with-current-model-id

# OpenRouter
OPENROUTER_API_KEY=replace-server-only
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace-with-current-model-id

# Ollama Cloud - no local Ollama daemon in MVP
OLLAMA_API_KEY=replace-server-only
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=replace-with-current-cloud-model-id
# Optional. If unset, semantic matching uses deterministic lexical fallback.
OLLAMA_EMBED_MODEL=

# Job discovery
BRAVE_SEARCH_API_KEY=replace-server-only

# Test gates
ENABLE_LIVE_AI_TESTS=0
ENABLE_LIVE_JOB_SOURCE_TESTS=0
