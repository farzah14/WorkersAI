# Web / app
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-server-only

# Database / storage
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CV_BUCKET=cvs
EXPORTS_BUCKET=exports

# Worker / queue
WORKER_POLL_SECONDS=1
LOG_LEVEL=INFO
DAILY_DISCOVERY_HOUR_JAKARTA=7
REQUIREMENT_EXTRACTION_ENABLED=true

# AI router (9Router unified gateway)
AI_PROVIDER_ORDER=9router
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# 9Router (OpenAI-compatible AI gateway)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=replace-server-only-or-leave-blank
NINEROUTER_MODEL=replace-with-configured-model-id
# Optional. If unset, semantic matching uses deterministic lexical fallback.
NINEROUTER_EMBED_MODEL=

# Job discovery
TAVILY_API_KEY=replace-server-only

# Test gates
RUN_LIVE_AI_TESTS=0
ENABLE_LIVE_JOB_SOURCE_TESTS=0
